            stickCup.classList.remove("shaking");
            const index = Math.floor(Math.random() * allPoems.length);
            currentPoem = allPoems[index];

            stickCup.style.display = "none";
            drawnStick.style.display = "block";
            drawnStick.innerHTML = "第<br>" + currentPoem.number + "<br>籤";

            status.innerHTML = "抽到 <strong>第 " + currentPoem.number + " 籤（" + currentPoem.title + "）</strong>";

            setTimeout(beginCups, 1000);
