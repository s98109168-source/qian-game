<!DOCTYPE html>
<html lang="zh-TW">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>線上求籤 | 職場心靈隨想</title>
    <style>
        :root {
            --bg-color: #f7f6f2;
            --card-bg: rgba(255, 255, 255, 0.85);
            --text-primary: #2b2b2b;
            --text-secondary: #6e6e73;
            --accent-color: #d4a373;
            --accent-hover: #bc8a5f;
            --accent-light: #fefae0;
            --border-color: #e6e1d6;
            --shadow: 0 12px 32px rgba(0, 0, 0, 0.05);
        }

        * {
            box-sizing: border-box;
            transition: all 0.3s ease;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "PingFang TC", "Microsoft JhengHei", sans-serif;
            background: linear-gradient(135deg, #f7f6f2 0%, #eef0eb 100%);
            color: var(--text-primary);
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        #app {
            width: 100%;
            max-width: 440px;
            text-align: center;
        }

        .header {
            margin-bottom: 24px;
        }

        .icon-symbol {
            font-size: 38px;
            margin-bottom: 8px;
            display: inline-block;
            opacity: 0.9;
        }

        h1 {
            font-size: 24px;
            font-weight: 600;
            letter-spacing: 2px;
            margin: 0 0 6px 0;
            color: var(--text-primary);
        }

        .subtitle {
            font-size: 13px;
            color: var(--text-secondary);
            letter-spacing: 1px;
        }

        .panel {
            background: var(--card-bg);
            backdrop-filter: blur(10px);
            border: 1px solid var(--border-color);
            border-radius: 24px;
            padding: 32px 24px;
            box-shadow: var(--shadow);
        }

        /* 籤筒區域 */
        #stickArea {
            height: 180px;
            display: flex;
            justify-content: center;
            align-items: center;
            margin-bottom: 10px;
        }

        #stickCup {
            width: 110px;
            height: 150px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 50px;
            background: #ffffff;
            border: 1px solid var(--border-color);
            border-radius: 20px;
            box-shadow: inset 0 0 10px rgba(0, 0, 0, 0.02), 0 8px 20px rgba(0, 0, 0, 0.04);
        }

        .shaking {
            animation: gentleShake 0.2s infinite;
        }

        @keyframes gentleShake {
            0% { transform: rotate(-5deg) translateY(-2px); }
            50% { transform: rotate(5deg) translateY(2px); }
            100% { transform: rotate(-5deg) translateY(-2px); }
        }

        #drawnStick {
            display: none;
            width: 90px;
            height: 160px;
            padding-top: 25px;
            background: #ffffff;
            border: 1px solid var(--accent-color);
            border-radius: 16px;
            color: var(--text-primary);
            font-size: 20px;
            font-weight: 500;
            line-height: 1.5;
            box-shadow: 0 10px 25px rgba(212, 163, 115, 0.2);
        }

        /* 狀態文字 */
        #status {
            min-height: 54px;
            font-size: 15px;
            line-height: 1.6;
            color: var(--text-secondary);
            margin: 16px 0 24px 0;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* 按鈕風格 */
        button {
            width: 100%;
            border: none;
            border-radius: 14px;
            padding: 14px 20px;
            background: var(--accent-color);
            color: #ffffff;
            font-size: 16px;
            font-weight: 500;
            letter-spacing: 1px;
            cursor: pointer;
            box-shadow: 0 4px 12px rgba(212, 163, 115, 0.3);
        }

        button:hover {
            background: var(--accent-hover);
        }

        button:active {
            transform: scale(0.98);
        }

        button:disabled {
            opacity: 0.4;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }

        /* 擲杯區 */
        #cupArea {
            display: none;
        }

        .tag-info {
            font-size: 14px;
            color: var(--text-secondary);
            margin-bottom: 8px;
        }

        #currentStick {
            color: var(--text-primary);
            font-weight: 600;
        }

        #progress {
            margin: 12px 0 20px 0;
            font-size: 14px;
            color: var(--text-secondary);
        }

        #progress span {
            color: var(--accent-color);
            font-weight: 600;
            font-size: 18px;
        }

        #cups {
            font-size: 54px;
            min-height: 80px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            margin: 10px 0;
        }

        .cupAnimation {
            animation: cupFloat 0.2s infinite;
        }

        @keyframes cupFloat {
            0% { transform: translateY(-4px) rotate(-8deg); }
            50% { transform: translateY(4px) rotate(8deg); }
            100% { transform: translateY(-4px) rotate(-8deg); }
        }

        #cupResult {
            min-height: 48px;
            font-size: 15px;
            line-height: 1.5;
            color: var(--text-secondary);
            margin-bottom: 20px;
        }

        /* 籤詩面板 */
        #poem {
            display: none;
            text-align: center;
            padding: 10px 0;
        }

        #poemTitle {
            font-size: 20px;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 20px;
        }

        #poemText {
            color: var(--text-primary);
            font-size: 18px;
            line-height: 2;
            letter-spacing: 2px;
            background: #ffffff;
            padding: 24px 16px;
            border-radius: 16px;
            border: 1px dashed var(--border-color);
            margin-bottom: 20px;
        }

        #meaning {
            color: var(--text-secondary);
            font-size: 14px;
            line-height: 1.8;
            text-align: left;
            background: var(--accent-light);
            padding: 16px 20px;
            border-radius: 14px;
        }

        /* 工具 */
        .hidden {
            display: none !important;
        }

        #restartButton {
            margin-top: 16px;
            background: transparent;
            color: var(--text-secondary);
            border: 1px solid var(--border-color);
            box-shadow: none;
        }

        #restartButton:hover {
            background: rgba(0, 0, 0, 0.03);
            color: var(--text-primary);
        }
    </style>
</head>

