            if (busy) return;
            busy = true;
            throwButton.disabled = true;
            cupResult.innerHTML = "擲杯中...";
            cups.classList.add("cupAnimation");

            setTimeout(finishCup, 900);
        }

        /* 判定擲杯結果 */
        function finishCup() {
            cups.classList.remove("cupAnimation");

            /* 機率邏輯保留：80% 聖杯, 10% 笑杯, 10% 陰杯 */
            const random = Math.random();
            let result;

            if (random < 0.80) {
                result = "holy";
            } else if (random < 0.90) {
                result = "laugh";
            } else {
                result = "negative";
            }

            /* 聖杯 */
            if (result === "holy") {
                holyCount++;
                cups.innerHTML = "🪙 🪙";
                cupResult.innerHTML = "<span style='color:#52b788; font-weight:600;'>聖杯！</span>";
                holyCountText.textContent = holyCount;

                if (holyCount === 3) {
                    cupResult.innerHTML = "<span style='color:#52b788; font-weight:600;'>連續三聖杯！</span><br>已獲得神明確認。";
                    throwButton.disabled = true;
                    setTimeout(confirmPoem, 1000);
                    return;
                }

                throwButton.textContent = "擲第 " + (holyCount + 1) + " 杯";
                throwButton.disabled = false;
                busy = false;
                return;
            }

            /* 笑杯 */
            if (result === "laugh") {
                cups.innerHTML = "🪙 😄 🪙";
                cupResult.innerHTML = "<span style='color:#e9c46a; font-weight:600;'>笑杯</span><br>未獲確認，需重新求籤。";
            } 
            /* 陰杯 */
            else {
                cups.innerHTML = "🪙 🔴 🪙";
                cupResult.innerHTML = "<span style='color:#e76f51; font-weight:600;'>陰杯</span><br>未獲確認，需重新求籤。";
            }

            setTimeout(failedDraw, 1500);
        }

        /* 求籤失敗重來 */
        function failedDraw() {
            cupArea.style.display = "none";
            drawArea.classList.remove("hidden");
            stickCup.style.display = "flex";
            drawnStick.style.display = "none";
            status.innerHTML = "這支籤未獲三聖杯確認。<br>請收拾心情，重新求籤。";
            startButton.textContent = "重新求籤";
            startButton.disabled = false;
            cups.innerHTML = "🪙 🪙";
            cupResult.innerHTML = "準備擲第一杯";
            holyCount = 0;
            holyCountText.textContent = "0";
            busy = false;
        }

        /* 確認籤詩顯示 */
        function confirmPoem() {
            cupArea.style.display = "none";
            poem.style.display = "block";
            poemTitle.textContent = "第 " + currentPoem.number + " 籤 - " + currentPoem.title;
            poemText.innerHTML = currentPoem.text.replace(/\n/g, "<br>");
